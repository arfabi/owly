# ============================================================================
# OWLY.AI — Root Git Ignore
# Mengabaikan dependencies, build outputs, environment variables, & logs
# ============================================================================

# Dependencies (Node.js & package managers)
node_modules/
*/node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Build & compiled outputs
dist/
*/dist/
**/dist/
.next/
*/.next/
**/.next/
out/
*/out/
build/
*/build/

# Next.js / TypeScript artifacts
*.tsbuildinfo
next-env.d.ts

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & secrets (Simpan .env.example sebagai referensi publik)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# OS & Editor generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project

# Temporary / Scratch files
tmp/
temp/
scratch/
.turbo/
.vercel/
playground/
docs/

video_narration.md 
video_plan.md 
video_motion.md
analyze_form.md
