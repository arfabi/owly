# ==============================================================================
# OWLY.AI - Environment Template
# ==============================================================================

# Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Baseten Inference API (Meta Muse Spark Reasoning)
BASETEN_API_KEY=your_baseten_api_key
BASETEN_BASE_URL=https://inference.baseten.co/v1
MUSE_SPARK_MODEL_NAME=meta-models/muse-spark-open-1026

# Meta Muse Voice Transcribe (Speech-to-Text Gateway)
# Specification: dev.meta.ai/docs/speech-to-text.md
MUSE_TRANSCRIBE_API_KEY=your_meta_or_baseten_api_key
MUSE_TRANSCRIBE_BASE_URL=https://api.meta.ai/v1
MUSE_TRANSCRIBE_MODEL_NAME=muse-voice-transcribe-1.0
